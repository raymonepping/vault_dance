# host-ubuntu: an Ubuntu 24.04 server. Outside the OS secrets engine's
# documented platform (RHEL only); the lab tests it and reports what Vault
# does. The image carries the OS and the `ansible` user only.
ARG UBUNTU_IMAGE
FROM ${UBUNTU_IMAGE}
ARG ANSIBLE_PUBKEY
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server sudo passwd python3 procps \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash ansible \
    && install -d -m 0700 -o ansible -g ansible /home/ansible/.ssh \
    && printf '%s\n' "$ANSIBLE_PUBKEY" > /home/ansible/.ssh/authorized_keys \
    && chown ansible:ansible /home/ansible/.ssh/authorized_keys \
    && chmod 0600 /home/ansible/.ssh/authorized_keys \
    && printf 'ansible ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/ansible \
    && chmod 0440 /etc/sudoers.d/ansible \
    && rm -f /etc/ssh/ssh_host_*
COPY start-sshd.sh /usr/local/sbin/start-sshd
RUN chmod 0755 /usr/local/sbin/start-sshd
EXPOSE 22
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD pgrep -x sshd >/dev/null || exit 1
CMD ["/usr/local/sbin/start-sshd"]
