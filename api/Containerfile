ARG NODE_IMAGE=docker.io/library/node:24-alpine
FROM ${NODE_IMAGE}

ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --omit=optional --no-audit --no-fund && npm cache clean --force
COPY server.js ./
COPY lib ./lib
COPY config ./config

# uid 1000, gid 1000: reads vault-agent's token sink (mode 0640, gid 1000)
# and the Vault log files (gid 1000).
USER 1000:1000
EXPOSE 3000

# /api/health answers 503 until a node is unsealed and the agent token exists.
HEALTHCHECK --interval=10s --timeout=4s --retries=6 --start-period=10s \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
