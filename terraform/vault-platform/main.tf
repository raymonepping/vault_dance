terraform {
  required_version = ">= 1.5.0"
  required_providers {
    vault = {
      source  = "hashicorp/vault"
      version = "~> 5.13"
    }
  }
  backend "local" {
    path = "../../.secrets/terraform/vault-platform.tfstate"
  }
}

# The cluster, with the scoped `terraform` token: exported by scripts/tf.sh.
# It may not create child tokens, so the provider uses its own.
provider "vault" {
  skip_child_token = true
}

variable "network_cidr" {
  description = "Subnet of vdnc-internal; AppRole identities may only log in from it"
  type        = string
}

variable "app_secret_id_ttl" {
  description = "Lifetime of the API's secret-ids in seconds (the rotator renews at 1/3 life)"
  type        = number
  default     = 7776000 # 90 days
}

# ── The scoped tokens' own policies ───────────────────────────────────────────
# Bootstrap wrote them once with the init root token; from then on Terraform
# owns them, since no root token is left to change them.
resource "vault_policy" "operator" {
  name   = "operator"
  policy = file("${path.module}/../../vault/policies/operator.hcl")
}

resource "vault_policy" "terraform" {
  name   = "terraform"
  policy = file("${path.module}/../../vault/policies/terraform.hcl")
}

# ── AppRole mount (tuned to allow 90-day secret-ids) ─────────────────────────
resource "vault_auth_backend" "approle" {
  type        = "approle"
  path        = "approle"
  description = "Machine identities: rotator, the API's agent, identity-secrets-init"
  tune {
    default_lease_ttl = "1h"
    max_lease_ttl     = "2160h"
  }
}

# ── dance-api: the console's own identity, through vault-agent's sink ────────
# Platform facts, credential reads for proofs only, orphans, health-check
# results. Person actions run on the person's token, never on this one.
resource "vault_policy" "dance_api" {
  name   = "dance-api"
  policy = file("${path.module}/../../vault/policies/dance-api.hcl")
}

resource "vault_approle_auth_backend_role" "dance_api" {
  backend               = vault_auth_backend.approle.path
  role_name             = "dance-api"
  token_policies        = ["default", vault_policy.dance_api.name]
  token_ttl             = 900
  token_max_ttl         = 3600
  secret_id_ttl         = var.app_secret_id_ttl
  token_bound_cidrs     = [var.network_cidr]
  secret_id_bound_cidrs = [var.network_cidr]
}

# ── Rotator identity (the one handed-over credential on the app plane) ───────
locals {
  rotated_roles = [vault_approle_auth_backend_role.dance_api.role_name]
}

resource "vault_policy" "dance_rotator" {
  name = "dance-rotator"
  policy = join("\n", [for r in local.rotated_roles : <<-EOT
    path "auth/approle/role/${r}/role-id" {
      capabilities = ["read"]
    }
    path "auth/approle/role/${r}/secret-id" {
      capabilities = ["create", "update"]
    }
    path "auth/approle/role/${r}/secret-id/lookup" {
      capabilities = ["create", "update"]
    }
    path "auth/approle/role/${r}/secret-id-accessor/destroy" {
      capabilities = ["create", "update"]
    }
  EOT
  ])
}

resource "vault_approle_auth_backend_role" "dance_rotator" {
  backend               = vault_auth_backend.approle.path
  role_name             = "dance-rotator"
  token_policies        = [vault_policy.dance_rotator.name]
  token_ttl             = 300
  token_max_ttl         = 600
  secret_id_ttl         = 0
  token_bound_cidrs     = [var.network_cidr]
  secret_id_bound_cidrs = [var.network_cidr]
}

# ── Identity secrets ──────────────────────────────────────────────────────────
# Every identity password (LDAP admin, the two system binds, Keycloak admin,
# the console's client secret, one per persona) lives here, generated by
# scripts/identity-secrets.sh, create-only.
resource "vault_mount" "kv" {
  path        = "kv"
  type        = "kv"
  options     = { version = "2" }
  description = "Lab secrets: identity stack passwords (kv/dance/identity/*)"
}

resource "vault_policy" "identity_secrets" {
  name   = "identity-secrets"
  policy = <<-EOT
    # One-shot identity-secrets-init: read the identity stack's secrets, nothing else.
    path "kv/data/dance/identity/*" {
      capabilities = ["read"]
    }
    path "kv/metadata/dance/identity/users" {
      capabilities = ["list"]
    }
    path "kv/metadata/dance/identity/system" {
      capabilities = ["list"]
    }
  EOT
}

resource "vault_approle_auth_backend_role" "identity_secrets" {
  backend               = vault_auth_backend.approle.path
  role_name             = "identity-secrets"
  token_policies        = [vault_policy.identity_secrets.name]
  token_ttl             = 120
  token_max_ttl         = 300
  secret_id_ttl         = 0
  token_bound_cidrs     = [var.network_cidr]
  secret_id_bound_cidrs = [var.network_cidr]
}

output "rotated_roles" {
  value = local.rotated_roles
}
